# Fluent host environment — installed to /etc/fluent/env (mode 0600) by
# deploy/install.sh, which fills FLUENT_HOME and the database paths and never
# overwrites an existing file. The systemd units in deploy/systemd/ read it
# through EnvironmentFile=; operators and MCP clients load it with
#   set -a; . /etc/fluent/env; set +a
# before starting a shell session or a worker client (systemd's EnvironmentFile
# never reaches processes it did not start).

# The operator's Fluent checkout with `npm ci` run. Workers must use a
# different checkout; this one is only pulled and checked by deploy/upgrade.sh.
FLUENT_HOME=/opt/fluent

# Live databases; both live under /var/lib/fluent, created by install.sh.
FLUENT_QUEUE_DB=/var/lib/fluent/queue.db
FLUENT_CONTROL_DB=/var/lib/fluent/control-plane.db

# GitHub token used by the timers, the CLI, and MCP servers started from this
# environment (`gh auth token` works). Fill in after install; keep this file 0600.
FLUENT_GITHUB_TOKEN=

# Backups older than this many days are pruned by deploy/bin/fluent-backup.
FLUENT_BACKUP_RETAIN_DAYS=14
