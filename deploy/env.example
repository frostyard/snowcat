# Snowcat host environment — installed to /etc/snowcat/env (mode 0600) by
# deploy/install.sh, which fills SNOWCAT_HOME and the database paths and never
# overwrites an existing file. The systemd units in deploy/systemd/ read it
# through EnvironmentFile=; operators and MCP clients load it with
#   set -a; . /etc/snowcat/env; set +a
# before starting a shell session or a worker client (systemd's EnvironmentFile
# never reaches processes it did not start).

# The operator's Snowcat checkout with `npm ci` run. Workers must use a
# different checkout; this one is only pulled and checked by deploy/upgrade.sh.
SNOWCAT_HOME=/opt/snowcat

# Live databases; both live under /var/lib/snowcat, created by install.sh.
SNOWCAT_QUEUE_DB=/var/lib/snowcat/queue.db
SNOWCAT_CONTROL_DB=/var/lib/snowcat/control-plane.db

# GitHub token used by the timers, the CLI, and MCP servers started from this
# environment (`gh auth token` works). Fill in after install; keep this file 0600.
SNOWCAT_GITHUB_TOKEN=

# Review gate (ADR-0065): set to 1 to let the verify-artifacts timer mark a
# draft pull request ready for review once a pr-review round passes — Snowcat's
# only GitHub write; SNOWCAT_GITHUB_TOKEN then needs pull-requests write on the
# gated repositories. Unset (the default) the pass is shown on the board and
# you run `gh pr ready <n>` yourself. The gate itself is per repository:
# `npm run queue -- review-gate <owner/repo> on`.
# SNOWCAT_REVIEW_GATE_WRITES=1

# Backups older than this many days are pruned by deploy/bin/snowcat-backup.
SNOWCAT_BACKUP_RETAIN_DAYS=14

# People and workers from anywhere (ADR-0063). Set BOTH to put the surface in
# Access mode (SNOWCAT_APP_TOKEN is then ignored): the team domain issues the
# Cf-Access-Jwt-Assertion the surface verifies, and the AUD tag names the
# Access application. Leave both unset for local mode.
# SNOWCAT_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# SNOWCAT_ACCESS_AUD=

