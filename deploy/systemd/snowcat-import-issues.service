# Snowcat issue import: for every enrolled repository, imports open GitHub
# issues labeled `snowcat` as proposed work (keyed by issue URL, so re-running
# never duplicates; the operator admits them). Needs SNOWCAT_GITHUB_TOKEN to
# read private repositories. Idempotent; run from snowcat-import-issues.timer.
# Configure `User=` and, when SNOWCAT_HOME is not /opt/snowcat, `ReadWritePaths=`
# in a drop-in; deploy/install.sh writes both. `npm` must resolve on systemd's
# fixed search path (/usr/local/bin or /usr/bin) or through that drop-in.
[Unit]
Description=Snowcat: import labeled GitHub issues for enrolled repositories
Documentation=https://github.com/frostyard/snowcat/blob/main/docs/design/queue-operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/snowcat/env
ExecStart=npm --prefix ${SNOWCAT_HOME} run --silent queue -- import-issues --enrolled --label snowcat
NoNewPrivileges=yes
# PrivateTmp gives tsx a writable compile cache under a private /tmp.
PrivateTmp=yes
ProtectSystem=strict
# The database directory plus the checkout's data/ (only used when the
# database variables are unset). Override ReadWritePaths= in the same drop-in
# when SNOWCAT_HOME is not /opt/snowcat.
ReadWritePaths=/var/lib/snowcat -/opt/snowcat/data
