# Snowcat feeder: for every repository that is opted in to the queue and
# `enrolled` in the control-plane store, seeds the standing read-only discovery
# roots, imports open GitHub issues labeled `snowcat` as proposed work (the
# operator admits them), sweeps the internal dependency chain (release-
# needed / dependency-bump proposals), and diffs each repository's GitHub
# settings against core's contract (settings-drift proposals). All steps are
# idempotent; run from
# snowcat-feed.timer. ExecStart= lines on a oneshot unit run in order and each
# runs only if the previous exited 0, so a feeder failure also skips the later
# steps and the unit reports failed. The import and the sweep need
# SNOWCAT_GITHUB_TOKEN to read private repositories. Install steps set `User=` in a drop-in
# (`systemctl edit snowcat-feed.service`) to the operator user that owns the
# databases, and create /etc/snowcat/env with SNOWCAT_HOME, SNOWCAT_QUEUE_DB,
# SNOWCAT_CONTROL_DB, and SNOWCAT_GITHUB_TOKEN. `npm` must resolve on systemd's
# fixed search path (/usr/local/bin or /usr/bin).
[Unit]
Description=Snowcat: seed discovery roots, import labeled issues, sweep internal dependencies, and check repository settings for enrolled repositories
Documentation=https://github.com/frostyard/snowcat/blob/main/docs/design/queue-operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/snowcat/env
ExecStart=npm --prefix ${SNOWCAT_HOME} run --silent queue -- seed-dogfood --enrolled
ExecStart=npm --prefix ${SNOWCAT_HOME} run --silent queue -- import-issues --enrolled --label snowcat
ExecStart=npm --prefix ${SNOWCAT_HOME} run --silent queue -- sweep-dependencies --enrolled
ExecStart=npm --prefix ${SNOWCAT_HOME} run --silent queue -- sweep-repository-settings --enrolled
NoNewPrivileges=yes
# PrivateTmp gives tsx a writable compile cache under a private /tmp.
PrivateTmp=yes
ProtectSystem=strict
# The database directory plus the checkout's data/ (only used when the
# database variables are unset). Override ReadWritePaths= in the same drop-in
# when SNOWCAT_HOME is not /opt/snowcat.
ReadWritePaths=/var/lib/snowcat -/opt/snowcat/data
