{
  "name": "@frostyard/snowcat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build && node scripts/check-dist.mjs && node scripts/check-boot.mjs",
    "check": "npm run check:audit && npm run check:docs && npm run check:deploy && npm run typecheck && npm run test:coverage && npm run check:coverage-floors && npm run check:coverage-denominator && npm run build",
    "check:audit": "npm audit --audit-level=high",
    "check:coverage-floors": "node scripts/check-coverage-floors.mjs",
    "check:coverage-denominator": "node scripts/check-coverage-denominator.mjs",
    "check:deploy": "bash scripts/check-deploy.sh",
    "check:docs": "node scripts/check-docs.mjs",
    "control": "node --import tsx src/control/cli.ts",
    "core": "node --import tsx src/core/cli.ts",
    "mcp": "node --import tsx src/mcp/stdio.ts",
    "queue": "node --import tsx src/queue/cli.ts",
    "repository": "node --import tsx src/repository/cli.ts",
    "serve": "node scripts/serve.mjs",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='test/**/*.ts' --test-coverage-lines=51 --test-coverage-branches=71 --test-coverage-functions=45 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=coverage/report.txt 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run check:docs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@flue/runtime": "2.0.3",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "hono": "4.13.3",
    "jsonc-parser": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@flue/vite": "2.0.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
